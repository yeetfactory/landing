{
  "name": "landing",
  "version": "0.0.1",
  "description": "Landing page for yeetfactory",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "format": "bun fmt --no-script --check .",
    "format:write": "bun fmt --no-script --write .",
    "lint": "oxlint -c .oxlintrc.json",
    "typecheck": "bun check --no-script",
    "knip": "knip --no-config-hints",
    "check": "bun run format && bun run lint && bun run typecheck && bun run knip",
    "prepare": "lefthook install --reset-hooks-path"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.93.0",
    "@rsbuild/core": "2.3.1",
    "@rsbuild/plugin-react": "2.1.1",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "knip": "6.44.2",
    "lefthook": "2.2.2",
    "oxlint": "1.93.0",
    "oxlint-plugin-react-doctor": "0.9.22",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
